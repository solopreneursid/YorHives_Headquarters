{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "yorphives-hq-free-pilot",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yorphives-hq-free-intelligence",
      "database_id": "209422af-3d1d-470d-b204-f5f5f33a2afa",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
